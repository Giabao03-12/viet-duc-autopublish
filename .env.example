# Sao chép thành .env.local (chạy máy) hoặc nhập vào Vercel > Settings > Environment Variables.
# KHÔNG commit, KHÔNG gửi trong chat.

# --- Meta / Facebook ---
META_PAGE_ID=1315954481600103
META_PAGE_ACCESS_TOKEN=        # Page token dài hạn (pages_manage_posts, pages_read_engagement)
META_APP_ID=
META_APP_SECRET=               # dùng để tự kiểm tra hạn token (debug_token)

# --- Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Lưu trữ (Vercel Marketplace > Upstash Redis tự điền 2 biến này) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Bảo mật ---
CRON_SECRET=                   # chuỗi ngẫu nhiên dài; Vercel Cron tự gửi kèm
ADMIN_PASSWORD=                # mật khẩu vào trang điều khiển
SESSION_SECRET=                # chuỗi ngẫu nhiên dài khác

# --- URL công khai của app (để Facebook tải ảnh) ---
PUBLIC_BASE_URL=https://ten-app.vercel.app

# --- Thông báo (chọn 1 hoặc cả 2) ---
NOTIFY_WEBHOOK_URL=            # Zapier Catch Hook -> Gmail
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Chạy thử không tốn API/không gọi Meta ---
MOCK_LLM=0
MOCK_META=0

# --- Claim đã được chủ page duyệt (19/10/2026) ---
APPROVED_CLAIMS=NANO-01,RICH-01,RICH-02,RICH-03
# PORTRAIT_CONFIRMED=1   # chỉ bật sau khi xác nhận ảnh viet-duc-01.png đúng là bạn
